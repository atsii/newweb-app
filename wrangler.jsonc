{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "newweb-app",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "9734f03e-22a3-44f3-b47a-88ee8e1d4bef","database_name": "newweb-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "10bb8a82d9e84eb3854cdd572d5df0c5" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
